{
  "name": "ai-model-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bun + TypeScript CLI: plan → execute → review with per-stage model routing (aimo)",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "aimo": "./src/app/cli.ts",
    "ai-model-orchestrator": "./src/app/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/app/cli.ts --help",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "depcruise": "depcruise src",
    "check:core-purity": "bash scripts/check-core-purity.sh",
    "docs": "typedoc",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run depcruise && bun run check:core-purity && bun test",
    "build:binary": "bun build --compile src/app/cli.ts --outfile dist/aimo",
    "prepare": "husky"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "commander": "14.0.3",
    "jsdom": "29.1.0",
    "picocolors": "1.1.1",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.3.13",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.6.0",
    "dependency-cruiser": "17.3.10",
    "eslint": "10.2.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsdoc": "62.9.0",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1"
  }
}
